  m_Script: {fileID: 11500000, guid: a4542380fdee4b82bff50b82360a14f4, type: 3}
  m_Name: Keyword List
  m_EditorClassIdentifier: 
  Tag: '[n] where n = index'
  Keywords:
  - Keyword: "<color=#FFD100>\uC5F0\uACC4</color>"
    Description: "\uC774\uC804\uC5D0 \uB2E4\uB978 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD588\uC744 \uB54C\uB9CC <color=#FFD100>\uC5F0\uACC4</color> \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC18C\uBA78</color>"
    Description: "\uD134 \uC885\uB8CC \uC804\uAE4C\uC9C0 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC774 \uCE74\uB4DC\uB294 [6](\uBC84\uB824\uC9D0/\uC18C\uBA78) \uCC98\uB9AC\uB429\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uBCF4\uC874</color>"
    Description: "\uC774 \uCE74\uB4DC\uB294 \uD134\uC774 \uB05D\uB098\uB3C4 \uBC84\uB824\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC810\uC220</color>"
    Description: "\uBF51\uC744 \uCE74\uB4DC \uB354\uBBF8\uC758 \uB9E8 \uC704 \uCE74\uB4DC X\uC7A5\uC744 \uBD05\uB2C8\uB2E4. \uC6D0\uD558\uB294 \uB9CC\uD07C \uBC84\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC601\uD63C\uACB0\uC18D</color>"
    Description: "\uC804\uD22C \uC2DC\uC791 \uC2DC \uC190\uD328\uC5D0 \uB4E4\uC5B4\uC635\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC0AC\uC6A9 \uBD88\uAC00</color>"
    Description: "\uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB2E4\uB978 \uCE74\uB4DC\uC5D0 \uC758\uD574 \uBC84\uB824\uC9C8 \uB54C \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uCD94\uBC29</color>"
    Description: "\uC0AC\uC6A9\uD55C \uD6C4 \uC804\uD22C\uC5D0\uC11C \uC81C\uC678\uB429\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC545\uB9C8</color>"
    Description: "<color=#FFD100>\uC545\uB9C8</color> \uCE74\uB4DC\uB294 \uD0C0\uB77D\uC744 1\uC911\uCCA9 \uC774\uC0C1 \uAC00\uC9C0\uACE0 \uC788\uC744 \uB54C\uB9CC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC601\uD63C\uC774 \uC801\uC744\uC218\uB85D \uD0C0\uB77D\uC744 \uC5BB\uC2B5\uB2C8\uB2E4. \uC790\uC2E0\uC774 \uAC00\uC9C4 <color=#FFD100>\uD0C0\uB77D</color>\uC758 \uC591\uC5D0 \uB530\uB77C \uC601\uD5A5\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC2E0\uC131</color>"
    Description: "<color=#FFD100>\uC2E0\uC131</color> \uCE74\uB4DC\uB294 \uC21C\uC218\uD568\uC744 1\uC911\uCCA9 \uC774\uC0C1 \uAC00\uC9C0\uACE0 \uC788\uC744 \uB54C\uB9CC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. [22](\uC601\uD63C)\uAC00 \uB9CE\uC744\uC218\uB85D \uC21C\uC218\uD568\uC744 \uC5BB\uC2B5\uB2C8\uB2E4. \uC790\uC2E0\uC774 \uAC00\uC9C4 <color=#FFD100>\uC21C\uC218\uD568</color>\uC758 \uC591\uC5D0 \uB530\uB77C \uC601\uD5A5\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uD798</color>"
    Description: "<color=#FFD100>\uD798</color> \uC911\uCCA9\uB2F9 \uBAA8\uB4E0 \uACF5\uACA9\uC758 \uD53C\uD574\uB7C9\uC774 1 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC778\uB0B4</color>"
    Description: "<color=#FFD100>\uC778\uB0B4</color> \uC911\uCCA9\uB2F9 \uBC29\uC5B4\uB3C4\uB97C 1 \uCD94\uAC00\uB85C \uC5BB\uC2B5\uB2C8\uB2E4. <color=#FFD100>\uBC29\uC5B4\uB3C4</color>\uB294 \uD53C\uD574\uB97C \uB9C9\uC544\uC8FC\uBA70 \uD134 \uC2DC\uC791 \uC2DC \uBAA8\uB450 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC21C\uC218\uD568</color>"
    Description: "[22](\uC601\uD63C)\uAC00 \uB9CE\uC744\uC218\uB85D <color=#FFD100>\uC21C\uC218\uD568</color>\uC744 \uC5BB\uC2B5\uB2C8\uB2E4. \uC790\uC2E0\uC774 \uAC00\uC9C4 <color=#FFD100>\uC21C\uC218\uD568</color>\uC5D0 \uB530\uB77C \uCE74\uB4DC\uAC00 \uC601\uD5A5\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uD0C0\uB77D</color>"
    Description: "[22](\uC601\uD63C)\uAC00 \uC801\uC744\uC218\uB85D <color=#FFD100>\uD0C0\uB77D</color>\uC744 \uC5BB\uC2B5\uB2C8\uB2E4. \uC790\uC2E0\uC774 \uAC00\uC9C4 <color=#FFD100>\uD0C0\uB77D</color>\uC5D0 \uB530\uB77C \uCE74\uB4DC\uAC00 \uC601\uD5A5\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC131\uC218</color>"
    Description: "<color=#FFD100>\uC131\uC218</color> \uC911\uCCA9 \uC218\uB9CC\uD07C [22](\uC601\uD63C)\uB97C \uC815\uD654\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC545\uB9C8 \uC8FC\uC785</color>"
    Description: "<color=#FFD100>\uC545\uB9C8 \uC8FC\uC785</color> \uC911\uCCA9 \uC218\uB9CC\uD07C [22](\uC601\uD63C)\uB97C \uD0C0\uB77D\uC2DC\uD0B5\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC57D\uD654</color>"
    Description: "\uACF5\uACA9 \uC2DC \uD53C\uD574\uB7C9\uC774 50% \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uCDE8\uC57D</color>"
    Description: "\uACF5\uACA9\uBC1B\uC744 \uB54C \uD53C\uD574\uB7C9\uC774 50% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uB178\uC1E0</color>"
    Description: "[21](\uBC29\uC5B4\uB3C4) \uD68D\uB4DD\uB7C9\uC774 50% \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC720\uD639</color>"
    Description: "\uB300\uC0C1\uC758 [22](\uC601\uD63C)\uC744 \uD0C0\uB77D\uC2DC\uD0A4\uB294 \uD6A8\uACFC\uAC00 50% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC808\uC81C</color>"
    Description: "\uB300\uC0C1\uC758 [22](\uC601\uD63C)\uC744 \uC815\uD654\uC2DC\uD0A4\uB294 \uD6A8\uACFC\uAC00 50% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC778\uC7A5</color>"
    Description: "<color=#FFD100>\uC778\uC7A5</color>\uC740 \uB2E4\uC74C \uBC88 \uC801\uC6A9\uB418\uB294 \uB514\uBC84\uD504\uB97C \uB9C9\uC544\uC90D\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uBC29\uC5B4\uB3C4</color>"
    Description: "<color=#FFD100>\uBC29\uC5B4\uB3C4</color> \uC218\uCE58\uB9CC\uD07C \uD53C\uD574\uB97C \uBC29\uC5B4\uD569\uB2C8\uB2E4. \uBAA8\uB4E0 <color=#FFD100>\uBC29\uC5B4\uB3C4</color>\uB294 \uD134 \uC2DC\uC791 \uC2DC \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC601\uD63C</color>"
    Description: "\uCCB4\uB825\uACFC \uB9C8\uCC2C\uAC00\uC9C0\uB85C, \uB2F9\uC2E0\uC758 <color=#FFD100>\uC601\uD63C</color>\uC740 \uB9CE\uC740 \uC801\uB4E4\uC5D0\uAC8C \uACF5\uACA9\uBC1B\uC2B5\uB2C8\uB2E4. \uC601\uD63C\uC774 \uC644\uC804\uD788 \uD0C0\uB77D\uD558\uBA74 \uAC8C\uC784\uC5D0\uC11C \uD328\uBC30\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uAC15\uD0C0 \uCE74\uB4DC</color>"
    Description: "<color=#FFD100>\uAC15\uD0C0 \uCE74\uB4DC</color>\uB294 \uC774\uB984\uC5D0 '\uAC15\uD0C0'\uAC00 \uD3EC\uD568\uB41C \uCE74\uB4DC\uC785\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uD6C4\uC18D\uD0C0</color>"
    Description: "<color=#FFD100>\uD6C4\uC18D\uD0C0</color>\uB294 \uBE44\uC6A9\uC774 0\uC778 \uACF5\uACA9 \uCE74\uB4DC\uC785\uB2C8\uB2E4. \uC774\uBC88 \uD134\uC5D0 \uC0AC\uC6A9\uD55C \uACF5\uACA9 \uCE74\uB4DC\uAC00 \uB9CE\uC744\uC218\uB85D \uD53C\uD574\uB7C9\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uD3C9\uD654\uC8FC\uC758\uC790</color>"
    Description: "\uC774\uBC88 \uD134\uC5D0 \uACF5\uACA9 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC558\uC744 \uB54C\uB9CC <color=#FFD100>\uD3C9\uD654\uC8FC\uC758\uC790</color> \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uCD9C\uD608</color>"
    Description: "\uB9E4 \uD134 \uC2DC\uC791 \uC2DC <color=#FFD100>\uCD9C\uD608</color> \uC911\uCCA9\uB9CC\uD07C \uD53C\uD574\uB97C \uBC1B\uC2B5\uB2C8\uB2E4. \uC774\uD6C4 \uCD9C\uD608 \uC218\uCE58\uAC00 \uC808\uBC18\uC73C\uB85C \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uB2E4\uC74C \uACF5\uACA9 \uBCF4\uB108\uC2A4</color>"
    Description: "\uB2E4\uC74C\uC5D0 \uAC00\uD558\uB294 \uACF5\uACA9\uC758 \uD53C\uD574\uB7C9\uC774 \uC911\uCCA9\uB41C \uC218\uCE58\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4. \uACF5\uACA9 \uD6C4 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC601\uD63C \uC99D\uD3ED</color>"
    Description: "\uB2E4\uC74C\uC5D0 \uBC1B\uB294 \uC601\uD63C \uC0C1\uD638\uC791\uC6A9(\uD68D\uB4DD \uB610\uB294 \uD53C\uD574)\uC758 \uD6A8\uACFC\uAC00 2\uBC30\uB85C \uC99D\uD3ED\uB429\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC784\uC2DC \uD798</color>"
    Description: "\uC774\uBC88 \uD134 \uB3D9\uC548 \uBAA8\uB4E0 \uCE74\uB4DC\uC758 \uD53C\uD574\uB7C9\uC774 \uC911\uCCA9\uB41C \uC218\uCE58\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4. \uD134 \uC885\uB8CC \uC2DC \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uAE30\uC808</color>"
    Description: "<color=#FFD100>\uAE30\uC808</color> \uC0C1\uD0DC\uC778 \uC720\uB2DB\uC740 \uC774\uBC88 \uD134\uC5D0 \uD589\uB3D9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD134 \uC885\uB8CC \uC2DC \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uD655\uC815 \uCD5C\uB300\uAC12</color>"
    Description: "\uB2E4\uC74C\uC5D0 \uAD74\uB9AC\uB294 \uC8FC\uC0AC\uC704\uB294 \uD56D\uC0C1 \uCD5C\uB300\uAC12\uC774 \uB098\uC635\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC8FC\uC0AC\uC704 \uAC15\uD654</color>"
    Description: "\uB2E4\uC74C\uC5D0 \uAD74\uB9AC\uB294 \uC8FC\uC0AC\uC704\uC758 \uCD5C\uC18C\uAC12\uACFC \uCD5C\uB300\uAC12\uC774 5 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - Keyword: "<color=#FFD100>\uC8FC\uC0AC\uC704 \uB450\uBC30</color>"
    Description: "\uB2E4\uC74C\uC5D0 \uAD74\uB9AC\uB294 \uC8FC\uC0AC\uC704\uC758 \uACB0\uACFC \uD6A8\uACFC\uAC00 2\uBC30\uB85C \uC801\uC6A9\uB429\uB2C8\uB2E4."
